/// Admin schedule → Lab allocate lots → Accountant invoice, vehicle, drums, and COA → Warehouse load.
model DispatchSchedule {
  id                String    @id @default(uuid()) @db.Uuid
  factoryId         String    @map("factory_id") @db.Uuid
  saleNo            String    @map("sale_no")
  customerId        String    @map("customer_id") @db.Uuid
  productId         String?   @map("product_id") @db.Uuid
  productCode       String    @map("product_code")
  productName       String    @map("product_name")
  qty               Decimal   @db.Decimal(12, 3)
  unit              String    @default("Kg")
  rate              Decimal   @db.Decimal(14, 4)
  isDiscounted      Boolean   @default(false) @map("is_discounted")
  puritySpec        Decimal?  @map("purity_spec") @db.Decimal(8, 4)
  clientPoNo        String?   @map("client_po_no")
  preferredBatchNos Json      @default("[]") @map("preferred_batch_nos")
  /// fg | byproduct
  scheduleKind      String    @default("fg") @map("schedule_kind")
  /// instructed | allocated | coa_issued | invoiced | dispatched
  status            String    @default("instructed")
  tallyInvoiceNo    String?   @map("tally_invoice_no")
  vehicleNo         String?   @map("vehicle_no")
  drumCount         Int?      @map("drum_count")
  /// Derived display only; per-lot COA on DispatchScheduleLot is source of truth
  coaNo             String?   @map("coa_no")
  coaIssuedAt       DateTime? @map("coa_issued_at") @db.Timestamptz(6)
  coaIssuedBy       String?   @map("coa_issued_by") @db.Uuid
  createdBy         String?   @map("created_by") @db.Uuid
  invoicedBy        String?   @map("invoiced_by") @db.Uuid
  invoicedAt        DateTime? @map("invoiced_at") @db.Timestamptz(6)
  pickedBy          String?   @map("picked_by") @db.Uuid
  pickedAt          DateTime? @map("picked_at") @db.Timestamptz(6)
  dispatchedBy      String?   @map("dispatched_by") @db.Uuid
  dispatchedAt      DateTime? @map("dispatched_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory    Factory               @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product    ProductionProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  creator    Profile?              @relation("DispatchScheduleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  invoicer   Profile?              @relation("DispatchScheduleInvoicedBy", fields: [invoicedBy], references: [id], onDelete: SetNull)
  picker     Profile?              @relation("DispatchSchedulePickedBy", fields: [pickedBy], references: [id], onDelete: SetNull)
  coaIssuer  Profile?              @relation("DispatchScheduleCoaIssuedBy", fields: [coaIssuedBy], references: [id], onDelete: SetNull)
  dispatcher Profile?              @relation("DispatchScheduleDispatchedBy", fields: [dispatchedBy], references: [id], onDelete: SetNull)
  lots       DispatchScheduleLot[]

  @@unique([factoryId, saleNo])
  @@index([factoryId])
  @@index([status])
  @@index([factoryId, status])
  @@index([factoryId, scheduleKind, status])
  @@map("dispatch_schedules")
}

model DispatchScheduleLot {
  id            String    @id @default(uuid()) @db.Uuid
  saleId        String    @map("sale_id") @db.Uuid

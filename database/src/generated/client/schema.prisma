  slug      String?  @unique
  emailFrom String   @default("sales@madstoq.com") @map("email_from")
  emailCc   String?  @map("email_cc")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members       SalesMembership[]
  leads         SalesLead[]
  documents     SalesDocument[]
  expenses      SalesExpense[]
  notifications SalesNotification[]

  @@map("sales_orgs")
}

model SalesMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  orgId     String   @map("org_id") @db.Uuid
  fullName  String   @map("full_name")
  email     String
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org SalesOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([userId])
  @@map("sales_users")
}

model SalesLead {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  companyName       String    @map("company_name")
  contactPerson     String?   @map("contact_person")
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  country           String?
  pincode           String?
  source            String?
  status            String    @default("new")
  expectedValue     String?   @map("expected_value")
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  notes             String?
  assignedTo        String?   @map("assigned_to") @db.Uuid
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  org        SalesOrg            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  activities SalesLeadActivity[]

  @@index([orgId])
  @@map("sales_leads")
}

model SalesLeadActivity {
  id           String   @id @default(uuid()) @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  activityType String   @map("activity_type")
  title        String?
  body         String?
  meta         Json?
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("sales_lead_activities")
}

model SalesDocument {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  leadId          String?   @map("lead_id") @db.Uuid
  docType         String    @map("doc_type")
  docNumber       String    @map("doc_number")
  docDate         DateTime  @map("doc_date") @db.Date
  toCompany       String?   @map("to_company")
  toContactPerson String?   @map("to_contact_person")
  toEmail         String?   @map("to_email")
  toPhone         String?   @map("to_phone")
  toAddress       String?   @map("to_address")
  subject         String?
  bodyHtml        String?   @map("body_html")
  bodyJson        Json?     @map("body_json")
  totalAmount     String?   @map("total_amount")
  currency        String?   @default("INR")
  status          String    @default("draft")
  pdfPath         String?   @map("pdf_path")
  pdfUrl          String?   @map("pdf_url")
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(6)
  sentTo          String?   @map("sent_to")
  sentCc          String?   @map("sent_cc")
  emailMessageId  String?   @map("email_message_id")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  org SalesOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, docType, docNumber])
  @@index([orgId])
  @@map("sales_documents")
}

model SalesExpense {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  title       String
  description String?
  category    String?
  amount      String
  currency    String   @default("INR")
  expenseDate DateTime @map("expense_date") @db.Date
  paidBy      String   @map("paid_by") @db.Uuid
  splitMethod String   @default("equal") @map("split_method")
  receiptPath String?  @map("receipt_path")
  receiptUrl  String?  @map("receipt_url")
  notes       String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org    SalesOrg            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  splits SalesExpenseSplit[]

  @@index([orgId])
  @@map("sales_expenses")
}

model SalesExpenseSplit {
  id             String    @id @default(uuid()) @db.Uuid
  expenseId      String    @map("expense_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  shareAmount    Decimal   @map("share_amount") @db.Decimal(14, 2)
  sharePercent   Decimal?  @map("share_percent") @db.Decimal(6, 3)
  isSettled      Boolean   @default(false) @map("is_settled")
  settledAt      DateTime? @map("settled_at") @db.Timestamptz(6)
  settledBy      String?   @map("settled_by") @db.Uuid
  lastReminderAt DateTime? @map("last_reminder_at") @db.Timestamptz(6)
  reminderCount  Int?      @default(0) @map("reminder_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  expense SalesExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@map("sales_expense_splits")
}

model SalesNotification {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  kind              String
  title             String
  body              String?
  linkUrl           String?   @map("link_url")
  relatedExpenseId  String?   @map("related_expense_id") @db.Uuid
  relatedSplitId    String?   @map("related_split_id") @db.Uuid
  relatedLeadId     String?   @map("related_lead_id") @db.Uuid
  relatedDocumentId String?   @map("related_document_id") @db.Uuid
  isRead            Boolean   @default(false) @map("is_read")
  readAt            DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  org SalesOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("sales_notifications")
}

// ─── PMC module ─────────────────────────────────────────────────────────────

model PmcUser {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id")
  fullName  String   @map("full_name")
  email     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pmc_users")
}

model PmcRawMaterial {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  name      String
  unit      String   @default("Kg")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, name])
  @@map("pmc_raw_materials")
}

model PmcProduct {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  name      String
  code      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  materials PmcProductMaterial[]
  params    PmcProductParams[]

  @@unique([userId, name])
  @@map("pmc_products")
}

model PmcProductMaterial {
  id            String  @id @default(uuid()) @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  rawMaterialId String  @map("raw_material_id") @db.Uuid
  qty           Decimal @db.Decimal(14, 4)
  isPrimary     Boolean @default(false) @map("is_primary")
  sortOrder     Int     @default(0) @map("sort_order")

  product PmcProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, rawMaterialId])
  @@map("pmc_product_materials")
}

model PmcReference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  refNumber String   @map("ref_number")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  prices PmcReferencePrice[]
  params PmcProductParams[]

  @@unique([userId, refNumber])
  @@map("pmc_references")
}

model PmcReferencePrice {
  id            String @id @default(uuid()) @db.Uuid
  referenceId   String @map("reference_id") @db.Uuid
  rawMaterialId String @map("raw_material_id") @db.Uuid
  price         String @default("0")

  reference PmcReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([referenceId, rawMaterialId])
  @@map("pmc_reference_prices")
}

model PmcProductParams {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  referenceId     String   @map("reference_id") @db.Uuid
  overhead        String   @default("0")
  batchMultiplier Decimal  @default(1) @map("batch_multiplier") @db.Decimal(14, 4)
  yieldValue      Decimal  @default(1) @map("yield_value") @db.Decimal(14, 4)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   PmcProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  reference PmcReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([productId, referenceId])
  @@map("pmc_product_params")
}

// ─── IO (inward/outward) module ───────────────────────────────────────────────

model IoUnit {
  id           Int      @id @default(autoincrement())
  name         String
  abbreviation String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products IoProduct[]

  @@map("io_units")
}

model IoCountry {
  id        Int      @id @default(autoincrement())
  name      String
  code      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  states    IoState[]
  companies IoCompany[]

  @@map("io_countries")
}

model IoState {
  id        Int      @id @default(autoincrement())
  countryId Int      @map("country_id")
  name      String
  code      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  country   IoCountry   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    IoCity[]
  companies IoCompany[]

  @@map("io_states")
}

model IoCity {
  id        Int      @id @default(autoincrement())
  stateId   Int      @map("state_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  state     IoState     @relation(fields: [stateId], references: [id], onDelete: Cascade)
  companies IoCompany[]

  @@map("io_cities")
}

model IoCompany {
  id          String   @id @default(uuid()) @db.Uuid
  factoryId   String?  @map("factory_id") @db.Uuid
  companyType String   @map("company_type")
  companyName String   @map("company_name")
  personTitle String?  @map("person_title")
  personName  String?  @map("person_name")
  countryId   Int?     @map("country_id")
  stateId     Int?     @map("state_id")
  cityId      Int?     @map("city_id")
  address     String?
  pincode     String?
  mobile      String?
  email       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory            Factory?          @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  country            IoCountry?        @relation(fields: [countryId], references: [id])
  state              IoState?          @relation(fields: [stateId], references: [id])
  city               IoCity?           @relation(fields: [cityId], references: [id])
  inwardSuppliers    IoInward[]        @relation("InwardSupplier")
  outwardSuppliers   IoOutward[]       @relation("OutwardSupplier")
  domesticCustomers  IoDomestic[]      @relation("DomesticCustomer")
  intlCustomers      IoInternational[] @relation("IntlCustomer")
  quotationCustomers IoQuotation[]     @relation("QuotationCustomer")

  @@index([factoryId])
  @@map("io_companies")
}

model IoProduct {
  id          String   @id @default(uuid()) @db.Uuid
  factoryId   String?  @map("factory_id") @db.Uuid
  productName String   @map("product_name")
  description String?
  hsnCode     String?  @map("hsn_code")
  unitId      Int?     @map("unit_id")
  rate        String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory            Factory?              @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  unit               IoUnit?               @relation(fields: [unitId], references: [id])
  inwardItems        IoInwardItem[]
  outwardItems       IoOutwardItem[]
  domesticItems      IoDomesticItem[]
  internationalItems IoInternationalItem[]
  quotationItems     IoQuotationItem[]

  @@map("io_products")
}

model IoNumberingConfig {
  factoryId    String   @map("factory_id") @db.Uuid
  docType      String   @map("doc_type")
  prefix       String   @default("")
  suffix       String   @default("")
  /// standard (seq/mm/yy) | slash_pad3 (prefix/001/yy, e.g. VIB/003/26)
  numberFormat String   @default("standard") @map("number_format")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@id([factoryId, docType])
  @@map("io_numbering_config")
}

model IoInward {
  id            String   @id @default(uuid()) @db.Uuid
  factoryId     String?  @map("factory_id") @db.Uuid
  inwardNumber  String   @map("inward_number")
  inwardDate    DateTime @map("inward_date") @db.Date
  supplierId    String?  @map("supplier_id") @db.Uuid
  supplierRefNo String?  @map("supplier_ref_no")
  remarks       String?
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory  Factory?       @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  supplier IoCompany?     @relation("InwardSupplier", fields: [supplierId], references: [id])
  items    IoInwardItem[]

  @@index([factoryId])
  @@map("io_inward")
}

model IoInwardItem {
  id        String  @id @default(uuid()) @db.Uuid
  inwardId  String  @map("inward_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Decimal @default(0) @db.Decimal(14, 4)
  price     String  @default("0")
  remarks   String?
  sortOrder Int     @default(0) @map("sort_order")

  inward  IoInward  @relation(fields: [inwardId], references: [id], onDelete: Cascade)
  product IoProduct @relation(fields: [productId], references: [id])

  @@map("io_inward_items")
}

model IoOutward {
  id            String   @id @default(uuid()) @db.Uuid
  factoryId     String?  @map("factory_id") @db.Uuid
  outwardNumber String   @map("outward_number")
  outwardDate   DateTime @map("outward_date") @db.Date
  supplierId    String?  @map("supplier_id") @db.Uuid
  supplierRefNo String?  @map("supplier_ref_no")
  remarks       String?
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory  Factory?        @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  supplier IoCompany?      @relation("OutwardSupplier", fields: [supplierId], references: [id])
  items    IoOutwardItem[]

  @@index([factoryId])
  @@map("io_outward")
}

model IoOutwardItem {
  id        String  @id @default(uuid()) @db.Uuid
  outwardId String  @map("outward_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Decimal @default(0) @db.Decimal(14, 4)
  price     String  @default("0")
  remarks   String?
  sortOrder Int     @default(0) @map("sort_order")

  outward IoOutward @relation(fields: [outwardId], references: [id], onDelete: Cascade)
  product IoProduct @relation(fields: [productId], references: [id])

  @@map("io_outward_items")
}

model IoDomestic {
  id               String   @id @default(uuid()) @db.Uuid
  factoryId        String?  @map("factory_id") @db.Uuid
  invoiceNumber    String   @map("invoice_number")
  taxInvoiceNumber String?  @map("tax_invoice_number")
  invoiceDate      DateTime @map("invoice_date") @db.Date
  customerId       String?  @map("customer_id") @db.Uuid
  remarks          String?

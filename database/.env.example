# Copy to database/.env — never commit database/.env
# Get values from Neon → Connect (VIB project) or Render → vib-io → Environment

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# VIB IO user (pnpm db:seed:vib-io / pnpm db:setup:vib-io)
VIB_USER_USERNAME="vib@123"
VIB_USER_EMAIL="ops@vibdyes.com"
VIB_USER_PASSWORD="change-me"
VIB_USER_NAME="VIB User"
CLIENT_SLUG="vib"
CLIENT_NAME="VIB Dyes"


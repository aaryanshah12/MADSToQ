model IoInternationalItem {
  id              String  @id @default(uuid()) @db.Uuid
  internationalId String  @map("international_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  quantity        Decimal @default(0) @db.Decimal(14, 4)
  price           String  @default("0")
  remarks         String?
  sortOrder       Int     @default(0) @map("sort_order")

  international IoInternational @relation(fields: [internationalId], references: [id], onDelete: Cascade)
  product       IoProduct       @relation(fields: [productId], references: [id])

  @@map("io_international_items")
}

model IoQuotation {
  id              String   @id @default(uuid()) @db.Uuid
  factoryId       String?  @map("factory_id") @db.Uuid
  quotationNumber String   @map("quotation_number")
  quotationDate   DateTime @map("quotation_date") @db.Date
  customerId      String?  @map("customer_id") @db.Uuid

// MADSTOQ Platform — core schema
// Client-specific tables belong in client migrations or dedicated schemas later.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Platform & tenancy ───────────────────────────────────────────────────────

model Client {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  workflows WorkflowDefinition[]

  @@map("clients")
}

model User {
  id           String   @id @default(cuid())
  username     String?  @unique
  email        String   @unique
  name         String
  passwordHash String?  @map("password_hash")
  role         UserRole @default(OPERATOR)
  clientId     String   @map("client_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]

  @@index([clientId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

// ─── Inventory (example domain) ─────────────────────────────────────────────

model InventoryItem {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  sku         String
  name        String
  description String?
  unit        String   @default("pcs")
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([clientId, sku])
  @@index([clientId])
  @@map("inventory_items")
}

// ─── Workflows (configurable) ─────────────────────────────────────────────────

model WorkflowDefinition {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  key       String
  name      String
  version   Int      @default(1)
  config    Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, key, version])
  @@map("workflow_definitions")
}

// ─── Chemical factory ERP (inventory module) ─────────────────────────────────

enum ProfileRole {
  owner
  inputer
  chemist
  accountant
  plant_supervisor
  warehouse_manager
  lab_incharge
}

model Factory {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  location        String?
  materials       Json?
  companyAddress  String?  @map("company_address")
  panNumber       String?  @map("pan_number")
  gstNumber       String?  @map("gst_number")
  gstRange        String?  @map("gst_range")
  gstDivision     String?  @map("gst_division")
  commissionerate String?
  email           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profileFactories       ProfileFactory[]
  stockEntries           StockEntry[]
  usageEntries           UsageEntry[]
  suppliers              Supplier[]
  customers              Customer[]
  dispatchSchedules      DispatchSchedule[]
  inoutProducts          FactoryInoutProduct[]
  inwardEntries          InwardEntry[]
  outwardEntries         OutwardEntry[]
  monthlyMaterial        MonthlyMaterialEntry[]
  salesEntries           SalesEntry[]
  ioCompanies            IoCompany[]
  ioProducts             IoProduct[]
  ioNumbering            IoNumberingConfig[]
  ioInwards              IoInward[]
  ioOutwards             IoOutward[]
  ioDomestics            IoDomestic[]
  ioInternationals       IoInternational[]
  ioQuotations           IoQuotation[]
  procurementPos         ProcurementPurchaseOrder[]
  procurementRequests    ProcurementMaterialRequest[]
  procurementReceipts    ProcurementReceipt[]
  qcInstruments          QcInstrument[]
  qcLogEntries           QcLogEntry[]
  qcParameterRequests    QcParameterRequest[]
  warehouseIssueRequests WarehouseIssueRequest[]
  inventoryNumbering     InventoryNumberingConfig[]
  inventoryDocCounters   InventoryDocCounter[]
  productionProducts     ProductionProduct[]
  productionBatches      ProductionBatch[]
  employees              Employee[]

  @@map("factories")
}

model InventoryNumberingConfig {
  factoryId    String   @map("factory_id") @db.Uuid
  docType      String   @map("doc_type")
  prefix       String   @default("")
  /// slash_seq_fy → {prefix}/{seq}/{FY}; seq_slash_prefix_fy → {seq}/{prefix}/{FY}
  numberFormat String   @default("slash_seq_fy") @map("number_format")
  padWidth     Int      @default(0) @map("pad_width")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@id([factoryId, docType])
  @@map("inventory_numbering_config")
}

model InventoryDocCounter {
  factoryId  String   @map("factory_id") @db.Uuid
  docType    String   @map("doc_type")
  fiscalYear String   @map("fiscal_year")
  lastSeq    Int      @default(0) @map("last_seq")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@id([factoryId, docType, fiscalYear])
  @@index([factoryId])
  @@map("inventory_doc_counters")
}

model Profile {
  id        String      @id @db.Uuid
  fullName  String      @map("full_name")
  email     String?
  phone     String?
  role      ProfileRole
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  profileFactories               ProfileFactory[]
  permissionOverrides            PermissionOverride[]
  stockEntries                   StockEntry[]                   @relation("StockCreatedBy")
  usageEntries                   UsageEntry[]                   @relation("UsageCreatedBy")
  procurementPos                 ProcurementPurchaseOrder[]     @relation("ProcurementCreatedBy")
  procurementRequests            ProcurementMaterialRequest[]   @relation("MaterialRequestCreatedBy")
  procurementReceiptsCreated     ProcurementReceipt[]           @relation("ReceiptCreatedBy")
  procurementReceiptsQc          ProcurementReceipt[]           @relation("ReceiptQcBy")
  procurementReceiptsReturned    ProcurementReceipt[]           @relation("ReceiptReturnedBy")
  qcLogEntriesCreated            QcLogEntry[]                   @relation("QcLogCreatedBy")
  qcParameterRequestsMade        QcParameterRequest[]           @relation("QcParamRequestedBy")
  warehouseIssueRequestsCreated  WarehouseIssueRequest[]        @relation("IssueRequestCreatedBy")
  warehouseIssueRequestsReleased WarehouseIssueRequest[]        @relation("IssueRequestReleasedBy")
  warehouseIssueReleases         WarehouseIssueRelease[]        @relation("IssueReleaseReleasedBy")
  productionBatchesCreated       ProductionBatch[]              @relation("ProductionBatchCreatedBy")
  productionBatchesQcSent        ProductionBatch[]              @relation("ProductionBatchQcSentBy")
  dispatchSchedulesCreated       DispatchSchedule[]             @relation("DispatchScheduleCreatedBy")
  dispatchSchedulesInvoiced      DispatchSchedule[]             @relation("DispatchScheduleInvoicedBy")
  dispatchSchedulesPicked        DispatchSchedule[]             @relation("DispatchSchedulePickedBy")
  dispatchSchedulesCoaIssued     DispatchSchedule[]             @relation("DispatchScheduleCoaIssuedBy")
  dispatchSchedulesDispatched    DispatchSchedule[]             @relation("DispatchScheduleDispatchedBy")
  dispatchScheduleLotsCoaIssued  DispatchScheduleLot[]          @relation("DispatchScheduleLotCoaIssuedBy")
  dispatchScheduleLotSignedCoas  DispatchScheduleLotSignedCoa[] @relation("DispatchScheduleLotSignedCoaUploadedBy")
  employee                       Employee?
  employeeDocumentsUploaded      EmployeeDocument[]             @relation("EmployeeDocUploadedBy")

  @@map("profiles")
}

model ProfileFactory {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  factoryId String @map("factory_id") @db.Uuid

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@unique([profileId, factoryId])
  @@map("profile_factories")
}

model PermissionOverride {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @map("profile_id") @db.Uuid
  feature   String
  isAllowed Boolean   @map("is_allowed")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("permission_overrides")
}

model StockEntry {
  id            String   @id @default(uuid()) @db.Uuid
  factoryId     String   @map("factory_id") @db.Uuid
  invoiceNumber String   @unique @map("invoice_number")
  supplierName  String   @map("supplier_name")
  materialType  String   @map("material_type")
  tonsLoaded    Decimal  @map("tons_loaded") @db.Decimal(10, 3)
  ratePerTon    String   @map("rate_per_ton")
  vehicleNumber String?  @map("vehicle_number")
  driverName    String?  @map("driver_name")
  entryDate     DateTime @map("entry_date") @db.Date
  notes         String?
  /// rm | sfg | fg | byproduct
  stockKind     String   @default("rm") @map("stock_kind")
  /// approved | rejected — rejected SFG lots are releasable but not RM for production.
  stockGrade    String   @default("approved") @map("stock_grade")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory             Factory              @relation(fields: [factoryId], references: [id])
  creator             Profile?             @relation("StockCreatedBy", fields: [createdBy], references: [id])
  usages              UsageEntry[]
  procurementReceipts ProcurementReceipt[]

  @@index([factoryId])
  @@index([factoryId, stockGrade])
  @@index([factoryId, stockKind])
  @@map("stock_entries")
}

model UsageEntry {
  id            String   @id @default(uuid()) @db.Uuid
  factoryId     String   @map("factory_id") @db.Uuid
  invoiceNumber String   @map("invoice_number")
  tonsUsed      Decimal  @map("tons_used") @db.Decimal(10, 3)
  processId     String?  @map("process_id")
  batchNotes    String?  @map("batch_notes")
  shift         String?
  usageDate     DateTime @map("usage_date") @db.Date
  batchMonth    String?  @map("batch_month")
  batchId       String?  @map("batch_id")
  /// rm | sfg | fg | byproduct — copied from the lot at post time (required, no default)
  stockKind     String   @map("stock_kind")
  /// plant_consume | warehouse_release | production_input | fg_dispatch | byproduct_dispatch
  usageReason   String   @default("plant_consume") @map("usage_reason")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  factory                Factory                 @relation(fields: [factoryId], references: [id])
  stockEntry             StockEntry              @relation(fields: [invoiceNumber], references: [invoiceNumber])
  creator                Profile?                @relation("UsageCreatedBy", fields: [createdBy], references: [id])
  warehouseIssueReleases WarehouseIssueRelease[]
  productionBatchRmLines ProductionBatchRmLine[]
  dispatchScheduleLots   DispatchScheduleLot[]

  @@index([factoryId])
  @@index([invoiceNumber])
  @@index([factoryId, stockKind])
  @@map("usage_entries")
}

model WarehouseIssueRequest {
  id           String    @id @default(uuid()) @db.Uuid
  factoryId    String    @map("factory_id") @db.Uuid
  materialType String    @map("material_type")
  qty          Decimal   @db.Decimal(12, 3)
  unit         String    @default("Kg")
  neededByDate DateTime? @map("needed_by_date") @db.Date
  notes        String?
  /// rm | sfg | fg — chemist cannot request fg.
  stockKind    String    @default("rm") @map("stock_kind")
  /// approved | rejected — request must be fulfilled from matching stock_grade lots.
  stockGrade   String    @default("approved") @map("stock_grade")
  status       String    @default("pending")
  qtyReleased  Decimal   @default(0) @map("qty_released") @db.Decimal(12, 3)
  createdBy    String?   @map("created_by") @db.Uuid
  releasedBy   String?   @map("released_by") @db.Uuid
  releasedAt   DateTime? @map("released_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory  Factory                 @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  creator  Profile?                @relation("IssueRequestCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  releaser Profile?                @relation("IssueRequestReleasedBy", fields: [releasedBy], references: [id], onDelete: SetNull)
  releases WarehouseIssueRelease[]

  @@index([factoryId])
  @@index([status])
  @@index([factoryId, status])
  @@map("warehouse_issue_requests")
}

model WarehouseIssueRelease {
  id            String   @id @default(uuid()) @db.Uuid
  requestId     String   @map("request_id") @db.Uuid
  invoiceNumber String   @map("invoice_number")
  qty           Decimal  @db.Decimal(12, 3)
  usageEntryId  String?  @map("usage_entry_id") @db.Uuid
  releasedBy    String?  @map("released_by") @db.Uuid
  releasedAt    DateTime @default(now()) @map("released_at") @db.Timestamptz(6)

  request    WarehouseIssueRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  usageEntry UsageEntry?           @relation(fields: [usageEntryId], references: [id], onDelete: SetNull)
  releaser   Profile?              @relation("IssueReleaseReleasedBy", fields: [releasedBy], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([invoiceNumber])
  @@map("warehouse_issue_releases")
}

model ProductionProduct {
  id                     String   @id @default(uuid()) @db.Uuid
  factoryId              String   @map("factory_id") @db.Uuid
  code                   String
  name                   String
  /// Printed on the certificate of analysis
  casNumber              String?  @map("cas_number")
  coaDescriptionSpec     String?  @map("coa_description_spec")
  coaIdentificationSpec  String?  @map("coa_identification_spec")
  coaSpecificGravitySpec String?  @map("coa_specific_gravity_spec")
  coaWaterSpec           String?  @map("coa_water_spec")
  coaBoilingPointSpec    String?  @map("coa_boiling_point_spec")
  coaGcPuritySpec        String?  @map("coa_gc_purity_spec")
  coaConclusion          String?  @map("coa_conclusion")
  coaStorageCondition    String?  @map("coa_storage_condition")
  /// sfg | fg
  kind                   String   @default("sfg")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory           Factory                  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  rms               ProductionProductRm[]
  stages            ProductionProcessStage[]
  outputs           ProductionOutputField[]
  batches           ProductionBatch[]
  dispatchSchedules DispatchSchedule[]

  @@unique([factoryId, code])
  @@index([factoryId])
  @@map("production_products")
}

model ProductionProductRm {
  id            String  @id @default(uuid()) @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  materialName  String  @map("material_name")
  unit          String  @default("Kg")
  sortOrder     Int     @default(0) @map("sort_order")
  allowMultiLot Boolean @default(false) @map("allow_multi_lot")
  lotRequired   Boolean @default(true) @map("lot_required")
  maxLots       Int     @default(2) @map("max_lots")
  /// rm | sfg — which warehouse lots the chemist picks on the batch
  stockKind     String  @default("rm") @map("stock_kind")
  /// sfg | fg — which process this input belongs to on the same product
  process       String  @default("sfg")

  product      ProductionProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchLines   ProductionBatchRmLine[]
  linkedStages ProductionProcessStage[] @relation("StageLotRm")

  @@index([productId])
  @@map("production_product_rms")
}

model ProductionProcessStage {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  name             String
  sortOrder        Int     @default(0) @map("sort_order")
  captureStartDate Boolean @default(true) @map("capture_start_date")
  captureEndDate   Boolean @default(true) @map("capture_end_date")
  captureStartTime Boolean @default(true) @map("capture_start_time")
  captureEndTime   Boolean @default(true) @map("capture_end_time")
  captureStartTemp Boolean @default(true) @map("capture_start_temp")
  captureEndTemp   Boolean @default(true) @map("capture_end_temp")
  captureIntegrity Boolean @default(false) @map("capture_integrity")
  /// sfg | fg
  process          String  @default("sfg")
  /// When set, this stage can be repeated per lot of that multi-lot RM
  lotRmDefId       String? @map("lot_rm_def_id") @db.Uuid

  product   ProductionProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotRm     ProductionProductRm?      @relation("StageLotRm", fields: [lotRmDefId], references: [id], onDelete: SetNull)
  stageLogs ProductionBatchStageLog[]

  @@index([productId])
  @@index([lotRmDefId])
  @@map("production_process_stages")
}

model ProductionOutputField {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  name        String
  sortOrder   Int     @default(0) @map("sort_order")
  isComputed  Boolean @default(false) @map("is_computed")
  /// Sibling output names whose qtys sum into this field (when isComputed).
  sumOf       Json?   @map("sum_of")
  /// When true, this finish output is included when the batch is sent for FG QC.
  requiresQc  Boolean @default(true) @map("requires_qc")
  /// When true, posted as a separate warehouse byproduct lot (not main FG/SFG).
  isByproduct Boolean @default(false) @map("is_byproduct")
  /// sfg | fg
  process     String  @default("sfg")

  product      ProductionProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchOutputs ProductionBatchOutput[]

  @@index([productId])
  @@map("production_output_fields")
}

model ProductionBatch {
  id               String    @id @default(uuid()) @db.Uuid
  factoryId        String    @map("factory_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  batchNo          String    @map("batch_no")
  /// sfg | fg — copied from product at create
  kind             String    @default("sfg")
  vessel           String?
  /// Manufacturing date sent to warehouse with FG lots.
  mfgDate          DateTime? @map("mfg_date") @db.Date
  /// Assay / purity % for warehouse FG lot.
  purity           Decimal?  @db.Decimal(8, 4)
  status           String    @default("draft")
  /// none | pending_qc | awaiting_admin | needs_info | approved | approved_printed | rejected
  qcStatus         String    @default("none") @map("qc_status")
  qcSentAt         DateTime? @map("qc_sent_at") @db.Timestamptz(6)
  qcSentBy         String?   @map("qc_sent_by") @db.Uuid
  /// Snapshot sent to lab: batch/product/vessel/outputs/RM lots
  qcSnapshot       Json?     @map("qc_snapshot")
  stickerPrintedAt DateTime? @map("sticker_printed_at") @db.Timestamptz(6)
  stickerPrintedBy String?   @map("sticker_printed_by") @db.Uuid
  stickerData      Json?     @map("sticker_data")
  createdBy        String?   @map("created_by") @db.Uuid
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  factory   Factory                   @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  product   ProductionProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  creator   Profile?                  @relation("ProductionBatchCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  qcSender  Profile?                  @relation("ProductionBatchQcSentBy", fields: [qcSentBy], references: [id], onDelete: SetNull)
  rmLines   ProductionBatchRmLine[]
  stageLogs ProductionBatchStageLog[]
  outputs   ProductionBatchOutput[]

  @@unique([factoryId, batchNo])
  @@index([factoryId])
  @@index([productId])
  @@index([status])
  @@index([qcStatus])
  @@index([factoryId, qcStatus])
  @@index([factoryId, status])
  @@map("production_batches")
}

model ProductionBatchRmLine {
  id           String  @id @default(uuid()) @db.Uuid
  batchId      String  @map("batch_id") @db.Uuid
  rmDefId      String  @map("rm_def_id") @db.Uuid
  qty          Decimal @default(0) @db.Decimal(12, 3)
  lotInvoice   String? @map("lot_invoice")
  lotSlot      Int?    @map("lot_slot")
  notes        String?
  usageEntryId String? @map("usage_entry_id") @db.Uuid

  batch      ProductionBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rmDef      ProductionProductRm @relation(fields: [rmDefId], references: [id], onDelete: Restrict)
  usageEntry UsageEntry?         @relation(fields: [usageEntryId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([lotInvoice])
  @@map("production_batch_rm_lines")
}

model ProductionBatchStageLog {
  id          String    @id @default(uuid()) @db.Uuid
  batchId     String    @map("batch_id") @db.Uuid
  stageId     String    @map("stage_id") @db.Uuid
  lotSlot     Int       @default(1) @map("lot_slot")
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  startTime   String?   @map("start_time")
  endTime     String?   @map("end_time")
  startTemp   Decimal?  @map("start_temp") @db.Decimal(10, 2)
  endTemp     Decimal?  @map("end_temp") @db.Decimal(10, 2)
  integrityOk Boolean?  @map("integrity_ok")
  /// Start/end for each wash chemical on a "Washing of crude" stage.
  washSteps   Json?     @map("wash_steps")

  batch ProductionBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stage ProductionProcessStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@unique([batchId, stageId, lotSlot])
  @@index([batchId])
  @@map("production_batch_stage_logs")
}

model ProductionBatchOutput {
  id            String  @id @default(uuid()) @db.Uuid
  batchId       String  @map("batch_id") @db.Uuid
  outputFieldId String  @map("output_field_id") @db.Uuid
  qty           Decimal @default(0) @db.Decimal(12, 3)

  batch       ProductionBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  outputField ProductionOutputField @relation(fields: [outputFieldId], references: [id], onDelete: Restrict)

  @@unique([batchId, outputFieldId])
  @@index([batchId])
  @@map("production_batch_outputs")
}

model Supplier {
  id                         String    @id @default(uuid()) @db.Uuid
  factoryId                  String    @map("factory_id") @db.Uuid
  name                       String
  companyAddress             String?   @map("company_address")
  gstNumber                  String?   @map("gst_number")
  zipcode                    String?
  email                      String?
  contactTitle               String?   @map("contact_title")
  contactName                String?   @map("contact_name")
  contactPhone               String?   @map("contact_phone")
  productSupplied            String?   @map("product_supplied")
  telFaxNo                   String?   @map("tel_fax_no")
  residenceNo                String?   @map("residence_no")
  bankName                   String?   @map("bank_name")
  bankBranch                 String?   @map("bank_branch")
  accountType                String?   @map("account_type")
  accountNo                  String?   @map("account_no")
